// WehttamSnaps Niri Configuration
// Author: Matthew (Crowdrocker)
// Hardware: AM5 Build - Ryzen 5 9600X, XFX RX 7600 8GB, 16GB DDR5 RAM, 850W PSU
// Display: DP-2 1920x1080@60Hz

// ╭─────────────────────────────── AUTOSTART ────────────────────────────────────────╮

// Core System Bridges & Wayland Tools
spawn-at-startup "xwayland-satellite"
spawn-sh-at-startup "swww-daemon" // Smooth wallpaper management
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "udiskie" "--tray"  // Secure storage auto-mounting
spawn-at-startup "blueman-applet"  // Bluetooth manager tray
spawn-at-startup "nm-applet"  // Network tray icon

// Polkit Authentication (Cleanly using single GNOME agent for native GTK integration)
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Desktop Shell & Status Components
spawn-at-startup "noctalia" // Handles bar layout, workspaces, and notifications natively
// spawn-at-startup "qs" "-c" "ii" // Quickshell alternative path hook
spawn-sh-at-startup "niriswitcher"

// Personalized Creative & System Customization Scripts
spawn-at-startup "bash" "-c" "~/.config/niri/scripts/config-watcher.sh start &"
spawn-at-startup "bash" "-c" "~/.config/niri/scripts/RainbowBorders.sh"
spawn-at-startup "~/.config/niri/scripts/save-program-list.sh"
spawn-at-startup "python3" "~/.config/niri/scripts/welcome.py"

// Interactive J.A.R.V.I.S Initialization with Audio Router Setup
// Launches your gaming profile cleanly 5 seconds after desktop load
spawn-at-startup "sh" "-c" "sound-system startup && notify-send 'J.A.R.V.I.S.' 'Systems online. Welcome back, Matthew.' -i audio-speakers"
spawn-at-startup "bash" "-c" "sleep 5 && ~/.config/niri/scripts/audio-routing.sh gaming"

// Power Management & Secure Lock Screen Hook
spawn-sh-at-startup "swayidle -w timeout 600 'swaylock' timeout 900 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep 'swaylock'"

// ╰──────────────────────────────────────────────────────────────────────────────────╯
