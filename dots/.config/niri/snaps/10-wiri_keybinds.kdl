// WehttamSnaps Niri Configuration
// Author: Matthew (Crowdrocker)
// Hardware: AM5 Build - Ryzen 5 9600X, XFX RX 7600 8GB, 16GB DDR5 RAM, 850W PSU
// Display: DP-2 1920x1080@60Hz

// ╭─────────────────────────────── KEYBINDINGS ──────────────────────────────────────╮
binds {

    // === WORKSPACE SWITCHING WITH SOUNDS ===
    Mod+1 { spawn "sh" "-c" "niri msg action focus-workspace 1 && sound-system workspace 1"; }
    Mod+2 { spawn "sh" "-c" "niri msg action focus-workspace 2 && sound-system workspace 2"; }
    Mod+3 { spawn "sh" "-c" "niri msg action focus-workspace 3 && sound-system workspace 3"; }
    Mod+4 { spawn "sh" "-c" "niri msg action focus-workspace 4 && sound-system workspace 4"; }
    Mod+5 { spawn "sh" "-c" "niri msg action focus-workspace 5 && sound-system workspace 5"; }
    Mod+6 { spawn "sh" "-c" "niri msg action focus-workspace 6 && sound-system workspace 6"; }
    Mod+7 { spawn "sh" "-c" "niri msg action focus-workspace 7 && sound-system workspace 7"; }
    Mod+8 { spawn "sh" "-c" "niri msg action focus-workspace 8 && sound-system workspace 8"; }
    Mod+9 { spawn "sh" "-c" "niri msg action focus-workspace 9 && sound-system workspace 9"; }
    Mod+0 { spawn "sh" "-c" "niri msg action focus-workspace 10 && sound-system workspace 10"; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // System
    Mod+Tab repeat=false    hotkey-overlay-title="toggle-overview"{ toggle-overview; }
    Mod+Shift+E    hotkey-overlay-title="quit"{ quit; }
    Mod+Escape allow-inhibiting=false    hotkey-overlay-title="toggle-keyboard-shortcuts-inhibit"{ toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+C    hotkey-overlay-title="niri_keybind_parser"{ spawn "python3" "~/.config/niri/niri_keybind_parser.py" "~/.config/niri/10-wiri_keybinds.kdl" "html"; }

    // ii Window Switcher (Alt+Tab)
    Alt+Tab    hotkey-overlay-title="altSwitcher-next"{ spawn "qs" "-c" "ii" "ipc" "call" "altSwitcher" "next"; }
    Alt+Shift+Tab    hotkey-overlay-title="altSwitcher-previous"{ spawn "qs" "-c" "ii" "ipc" "call" "altSwitcher" "previous"; }

    // ii Overlay
    Super+G    hotkey-overlay-title="overlay"{ spawn "qs" "-c" "ii" "ipc" "call" "overlay" "toggle"; }

    // ii Clipboard
    Mod+V    hotkey-overlay-title="clipboard"{ spawn "qs" "-c" "ii" "ipc" "call" "clipboard" "toggle"; }

    // ii Lock screen
    Mod+Alt+L allow-when-locked=true    hotkey-overlay-title="lock"{ spawn "qs" "-c" "ii" "ipc" "call" "lock" "activate"; }

    // ii Region tools
    Mod+Shift+S { spawn "qs" "-c" "ii" "ipc" "call" "region" "screenshot"; }
    Mod+Shift+X    hotkey-overlay-title="region-ocr"{ spawn "qs" "-c" "ii" "ipc" "call" "region" "ocr"; }
    Mod+Shift+A    hotkey-overlay-title="region-search"{ spawn "qs" "-c" "ii" "ipc" "call" "region" "search"; }

    // ii Wallpaper selector
    Ctrl+Alt+T    hotkey-overlay-title="wallpaperSelector"{ spawn "qs" "-c" "ii" "ipc" "call" "wallpaperSelector" "toggle"; }

    // ii Settings
    Mod+Comma    hotkey-overlay-title="settings"{ spawn "qs" "-c" "ii" "ipc" "call" "settings" "open"; }

    // ii Cheatsheet
    Mod+Slash    hotkey-overlay-title="cheatsheet"{ spawn "qs" "-c" "ii" "ipc" "call" "cheatsheet" "toggle"; }

    // ii Panel family (cycle between Material ii and Waffle styles)
    Mod+Shift+W    hotkey-overlay-title="panelFamily"{ spawn "qs" "-c" "ii" "ipc" "call" "panelFamily" "cycle"; }

    // ═══════════════════════════════════════
    // J.A.R.V.I.S. VISUAL MENU SYSTEM
    // ═══════════════════════════════════════

    // Main J.A.R.V.I.S. Command Center (Full Menu)
    Mod+Space    hotkey-overlay-title="jarvis-menu-main"{ spawn "jarvis-menu" "main"; }

    // Quick App Launcher (No categories)
    Mod+Alt+A    hotkey-overlay-title="jarvis-menu-apps"{ spawn "jarvis-menu" "apps"; }

    // Quick Workspace Switcher
    Mod+W    hotkey-overlay-title="jarvis-menu-workspaces"{ spawn "jarvis-menu" "workspaces"; }

    // Free-Form Command Input
    Mod+Alt+Slash    hotkey-overlay-title="jarvis-menu-command"{ spawn "jarvis-menu" "command"; }

    // J.A.R.V.I.S. Interactive Terminal
    Mod+Alt+J    hotkey-overlay-title="jarvis-menu-interactive"{ spawn "konsole" "-e" "jarvis" "interactive"; }

    // Window management
    Mod+Q repeat=false    hotkey-overlay-title="close-window"{ spawn "bash" "-c" "$HOME/.config/quickshell/ii/scripts/close-window.sh"; }
    Mod+D { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+A { toggle-window-floating; }

    // Focus
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // Move windows
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // === GAMING MODE TOGGLE ===
    Mod+G    hotkey-overlay-title="sound-system gaming-toggle" { spawn "sound-system" "gaming-toggle"; }

    // Gaming and media management manager script
    Mod+Shift+G    hotkey-overlay-title="toggle-gaming-mode" { spawn "~/.config/niri/scripts/jarvis-manager.sh"; }
    Mod+Alt+R    hotkey-overlay-title="niri-validate" { spawn "~/bin/niri-validate.sh"; }

    // ── APPLICATIONS ──
    Mod+T { spawn "ghostty"; }
    Mod+Return { spawn "ghostty"; }
    Mod+B    hotkey-overlay-title="Open Vivaldi" { spawn "vivaldi-stable"; }
    Super+E    hotkey-overlay-title="Open Thunar" { spawn "thunar"; }
    Mod+Alt+D    hotkey-overlay-title="Open Rofi" { spawn "rofi" "-show" "drun"; }
    Mod+Shift+B   hotkey-overlay-title="Open Brave" { spawn "brave"; }
    Mod+Alt+H   hotkey-overlay-title="Show Keyhints" { spawn "sh" "-c" "~/.config/niri/scripts/KeyHints.sh"; }
    Mod+Shift+N   hotkey-overlay-title="Show Quick Settings" { spawn "sh" "-c" "~/.config/niri/scripts/niri_quick_settings.sh"; }
    Mod+Shift+T   hotkey-overlay-title="Open Kate" { spawn "kate"; }

    // OBS Studio
    Mod+O   hotkey-overlay-title="Open OBS" { spawn "flatpak" "run" "com.obsproject.Studio"; }
    Mod+P   hotkey-overlay-title="Open spotify-launcher" { spawn "spotify-launcher"; }

    // ── WEBAPPS ──
    Mod+Ctrl+T   hotkey-overlay-title="twitch"  { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh twitch"; }
    Mod+Ctrl+Y   hotkey-overlay-title="youtube"  { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh youtube"; }
    Mod+Ctrl+S   hotkey-overlay-title="spotify"  { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh spotify"; }
    Mod+Ctrl+D   hotkey-overlay-title="discord"  { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh discord"; }

    // ── GAMING & GAME LAUNCHERS ──
    Mod+Alt+P  hotkey-overlay-title="Open protonup-qt" { spawn "protonup-qt"; }
    
    // Screenshot integration tools
    Mod+Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
}
// ╰──────────────────────────────────────────────────────────────────────────────────╯
