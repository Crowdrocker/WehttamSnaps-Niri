// === WELCOME APP ===
window-rule {
    match title="Welcome to WehttamSnaps"
    match app-id="^python3$|^python$"
    geometry-corner-radius 8
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
}

// === SPECIAL MODDING FEATURES ===
window-rule {
    match app-id="^steamtinkerlaunch$|^vortex$|^modorganizer2$"
    match is-focused=true
}

window-rule {
    match app-id="^steamtinkerlaunch$|^vortex$|^modorganizer2$"
    match title="^Progress$|^Downloading$|^Installing$|^Deploying$"
    match is-focused=true
}

// Picture-in-Picture always floats
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="brave-browser$" title="^Picture-in-Picture$"
    match app-id="Vivaldi-stable$" title="^Picture-in-Picture$"
    match title="Picture-in-Picture"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// ─── UTILITY WINDOWS ───
window-rule {
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id="^helvum$"
    match title="^KeyHints$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    }
    window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id="^nwg-look$"
    match app-id="^nwg-displays$"
    match app-id="^nwg-drawer$"
    match app-id="^lxappearance$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    }
    window-rule {
    match app-id="^qs$"
    match app-id="^quickshell$"
    open-floating true
    }
    // ╭───────────────────── LAYER RULES ─────────────────────╮
    layer-rule {
    match namespace="quickshell:iiBackdrop"
    place-within-backdrop true
    opacity 1.0
    }
    layer-rule {
    match namespace="quickshell:wBackdrop"
    place-within-backdrop true
    opacity 1.0
    }
    // Default rounded corners for all windows
    window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    }
    // Inactive window opacity
    window-rule {
    match is-active=false
    opacity 0.9
    }
    // Gnome apps with special styling (FIXED SYNTAX TYPO HERE)
    window-rule {
    match app-id=r#"^org.gnome."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
    }
    window-rule {
    match app-id="zoom"
    open-floating true
    }
    layer-rule {
    match namespace="^swww-daemon$"
    place-within-backdrop true
    }
    layer-rule {
    match namespace="^quickshell-wallpaper$"
    }
    layer-rule {
    match namespace="^quickshell-overview$"
    place-within-backdrop true
    }
    // ╭─────────────────────────────── SCREENCASTS SETTINGS ───────────────────────────────────╮
    window-rule {
    match app-id=r#"^org.keepassxc.KeePassXC$"#
    match app-id=r#"^org.gnome.World.Secrets$"#
    block-out-from "screencast"
    }
    // Indicate screencasted windows with red colors
    window-rule {
    match is-window-cast-target=true
    focus-ring {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
    }
    border {
    inactive-color "#7d0d2d"
    }
    shadow {
    color "#7d0d2d70"
    }
    tab-indicator {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
    }
    }
    // Generic webapp rule (catches all webapps)
    window-rule {
    match app-id=r#"^.*-webapp$"#
    geometry-corner-radius 12
    open-floating true
    default-column-width { fixed 1300; }
    default-window-height { fixed 850; }
    focus-ring {
    width 3
    active-gradient from="#89b4fa" to="#b4c8fa" angle=45 relative-to="workspace-view"
    inactive-gradient from="#45475a" to="#585b70" angle=45 relative-to="workspace-view"
    }
    }
    // ╰──────────────────────────────────────────────────────────────────────────────────╯
    // ╭─────────────────────────────── WEBAPP WINDOW RULES ───────────────────────────────────╮
    // === WEBAPP WINDOW RULES ===
    // Add these to your rules.kdl file

    // YouTube Webapp
    window-rule {
        match app-id="^youtube-webapp$"
        match title="YouTube"
        geometry-corner-radius 12
        open-floating true
        default-column-width { fixed 1400; }
        default-window-height { fixed 900; }
        open-on-workspace "7"

        border {
            width 2
            active-gradient from="#ff0000" to="#cc0000" angle=45 relative-to="workspace-view"
            inactive-gradient from="#313244" to="#45475a" angle=45 relative-to="workspace-view"
        }
    }

    // Twitch Webapp
    window-rule {
        match app-id="^twitch-webapp$"
        match title="Twitch"
        geometry-corner-radius 12
        open-floating true
        default-column-width { fixed 1400; }
        default-window-height { fixed 900; }
        open-on-workspace "7"

        border {
            width 2
            active-gradient from="#9146ff" to="#772ce8" angle=45 relative-to="workspace-view"
            inactive-gradient from="#313244" to="#45475a" angle=45 relative-to="workspace-view"
        }
    }

    // Spotify Webapp
    window-rule {
        match app-id="^spotify-webapp$"
        match title="Spotify"
        geometry-corner-radius 12
        open-floating true
        default-column-width { fixed 1200; }
        default-window-height { fixed 800; }
        open-on-workspace "8"

        border {
            width 2
            active-gradient from="#1db954" to="#1ed760" angle=45 relative-to="workspace-view"
            inactive-gradient from="#313244" to="#45475a" angle=45 relative-to="workspace-view"
        }
    }

    // Discord Webapp
    window-rule {
        match app-id="^discord-webapp$"
        match title="Discord"
        geometry-corner-radius 12
        open-floating true
        default-column-width { fixed 1300; }
        default-window-height { fixed 900; }
        open-on-workspace "7"

        border {
            width 2
            active-gradient from="#5865f2" to="#7289da" angle=45 relative-to="workspace-view"
            inactive-gradient from="#313244" to="#45475a" angle=45 relative-to="workspace-view"
        }
    }

    // Gmail Webapp
    window-rule {
        match app-id="^gmail-webapp$"
        match title="Gmail"
        geometry-corner-radius 12
        open-floating true
        default-column-width { fixed 1400; }
        default-window-height { fixed 900; }
        open-on-workspace "7"
    }

    // GitHub Webapp
    window-rule {
        match app-id="^github-webapp$"
        match title="GitHub"
        geometry-corner-radius 12
        open-floating true
        default-column-width { fixed 1400; }
        default-window-height { fixed 900; }
        open-on-workspace "2"
    }
